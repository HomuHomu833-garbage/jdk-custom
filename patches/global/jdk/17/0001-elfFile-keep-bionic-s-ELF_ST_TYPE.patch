elfFile.hpp: don't redefine ELF_ST_TYPE on android

bionic's <linux/elf.h>, reached via <elf.h>, already defines ELF_ST_TYPE(x)
as a function-like macro. HotSpot then redefines it as an object-like alias
for ELF{32,64}_ST_TYPE, which clashes and leaves the call sites in
elfSymbolTable.cpp unable to resolve, breaking every android build:

  elfSymbolTable.cpp:50:19: error: use of undeclared identifier 'ELF64_ST_TYPE'

Keep bionic's definitions instead. The guard is android-only, so this is a
no-op for every other target.

Matches termux-packages openjdk-25 patch 0024 (Henrik Grimler).

diff --git a/src/hotspot/share/utilities/elfFile.hpp b/src/hotspot/share/utilities/elfFile.hpp
index 0caafc7..b2e82c7 100644
--- a/src/hotspot/share/utilities/elfFile.hpp
+++ b/src/hotspot/share/utilities/elfFile.hpp
@@ -46,7 +46,7 @@ typedef Elf64_Shdr      Elf_Shdr;
 typedef Elf64_Phdr      Elf_Phdr;
 typedef Elf64_Sym       Elf_Sym;
 
-#if !defined(_ALLBSD_SOURCE) || defined(__APPLE__)
+#if (!defined(_ALLBSD_SOURCE) || defined(__APPLE__)) && !defined(__ANDROID__)
 #define ELF_ST_TYPE ELF64_ST_TYPE
 #endif
 
@@ -62,7 +62,7 @@ typedef Elf32_Shdr      Elf_Shdr;
 typedef Elf32_Phdr      Elf_Phdr;
 typedef Elf32_Sym       Elf_Sym;
 
-#if !defined(_ALLBSD_SOURCE) || defined(__APPLE__)
+#if (!defined(_ALLBSD_SOURCE) || defined(__APPLE__)) && !defined(__ANDROID__)
 #define ELF_ST_TYPE ELF32_ST_TYPE
 #endif
 #endif
