os_linux_x86: no <fpu_control.h> on android

glibc's <fpu_control.h> has no bionic equivalent, and 8 includes it
unconditionally -- not behind the #ifndef AMD64 that later releases put it
under -- so it breaks every android x86 target rather than just the 32-bit one:

  fatal error: 'fpu_control.h' file not found

Guard the include, and the four users of the x87 control word, on __ANDROID__
as well as AMD64. The x87 precision control is a no-op for anything bionic
runs: the JIT uses SSE for floating point on every android x86 device.

Same change as 0014 on 11+, and the companion to what termux-packages carries
as 0013-Don-t-run-fpu_control-related-functions-on-Android.

diff --git a/hotspot/src/os_cpu/linux_x86/vm/os_linux_x86.cpp b/hotspot/src/os_cpu/linux_x86/vm/os_linux_x86.cpp
index 12b5ca0..ec046c5 100644
--- a/hotspot/src/os_cpu/linux_x86/vm/os_linux_x86.cpp
+++ b/hotspot/src/os_cpu/linux_x86/vm/os_linux_x86.cpp
@@ -72,7 +72,9 @@
 # include <pwd.h>
 # include <poll.h>
 # include <ucontext.h>
+#ifndef __ANDROID__
 # include <fpu_control.h>
+#endif
 
 #ifdef AMD64
 #define REG_SP REG_RSP
@@ -545,14 +547,14 @@ JVM_handle_linux_signal(int sig,
 }
 
 void os::Linux::init_thread_fpu_state(void) {
-#ifndef AMD64
+#if !defined(AMD64) && !defined(__ANDROID__)
   // set fpu to 53 bit precision
   set_fpu_control_word(0x27f);
 #endif // !AMD64
 }
 
 int os::Linux::get_fpu_control_word(void) {
-#ifdef AMD64
+#if defined(AMD64) || defined(__ANDROID__)
   return 0;
 #else
   int fpu_control;
@@ -562,7 +564,7 @@ int os::Linux::get_fpu_control_word(void) {
 }
 
 void os::Linux::set_fpu_control_word(int fpu_control) {
-#ifndef AMD64
+#if !defined(AMD64) && !defined(__ANDROID__)
   _FPU_SETCW(fpu_control);
 #endif // !AMD64
 }
@@ -870,7 +872,7 @@ void os::print_register_info(outputStream *st, void *context) {
 }
 
 void os::setup_fpu() {
-#ifndef AMD64
+#if !defined(AMD64) && !defined(__ANDROID__)
   address fpu_cntrl = StubRoutines::addr_fpu_cntrl_wrd_std();
   __asm__ volatile (  "fldcw (%0)" :
                       : "r" (fpu_cntrl) : "memory");
