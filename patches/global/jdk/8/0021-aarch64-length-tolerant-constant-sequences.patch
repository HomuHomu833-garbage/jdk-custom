+static bool is_movk64(address insn_addr, unsigned hw, unsigned rd) {
+  unsigned insn = *(unsigned*)insn_addr;
+  return Instruction_aarch64::extract(insn, 31, 31) == 1 &&
+         Instruction_aarch64::extract(insn, 30, 23) == 0b11100101 &&
+         Instruction_aarch64::extract(insn, 22, 21) == hw &&
+         Instruction_aarch64::extract(insn, 4, 0) == rd;
+}
