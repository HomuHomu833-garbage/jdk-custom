LinuxVirtualMachine: no confstr on android

isLinuxThreads() asks confstr(_CS_GNU_LIBPTHREAD_VERSION) whether the runtime
is pre-NPTL glibc. bionic has neither the function nor the constant, and clang
makes an implicit declaration fatal:

  LinuxVirtualMachine.c:205:9: error: call to undeclared function 'confstr';
      ISO C99 and later do not support implicit function declarations

The question has a fixed answer there: bionic's pthreads are NPTL-like, never
LinuxThreads, so return JNI_FALSE and skip the probe. Same reasoning as patch
0002 for hotspot's own libpthread_init().

diff --git a/jdk/src/solaris/native/sun/tools/attach/LinuxVirtualMachine.c b/jdk/src/solaris/native/sun/tools/attach/LinuxVirtualMachine.c
index 6017308..4ecebef 100644
--- a/jdk/src/solaris/native/sun/tools/attach/LinuxVirtualMachine.c
+++ b/jdk/src/solaris/native/sun/tools/attach/LinuxVirtualMachine.c
@@ -195,6 +195,11 @@ JNIEXPORT void JNICALL Java_sun_tools_attach_LinuxVirtualMachine_connect
 JNIEXPORT jboolean JNICALL Java_sun_tools_attach_LinuxVirtualMachine_isLinuxThreads
   (JNIEnv *env, jclass cls)
 {
+#ifdef __ANDROID__
+    /* bionic has no confstr, and its pthreads are NPTL-like rather than
+     * LinuxThreads, which is what this is asking. */
+    return JNI_FALSE;
+#else
 # ifndef _CS_GNU_LIBPTHREAD_VERSION
 # define _CS_GNU_LIBPTHREAD_VERSION 3
 # endif
@@ -222,6 +227,7 @@ JNIEXPORT jboolean JNICALL Java_sun_tools_attach_LinuxVirtualMachine_isLinuxThre
     res = (jboolean)(strstr(s, "NPTL") == NULL);
     free(s);
     return res;
+#endif
 }
 
